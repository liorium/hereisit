{
  "name": "@hereisit/image-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch dist/server.mjs",
    "build": "esbuild src/server.ts src/job/job-runner.ts --bundle --platform=node --format=esm --target=node24 --outdir=dist --out-extension:.js=.mjs",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. apps/image-engine/src"
  },
  "dependencies": {
    "@hereisit/server-contracts": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.10",
    "esbuild": "0.28.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
