{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hereisit.example/schemas/image-engine-commercial-review-v1.json",
  "title": "HereIsIt image engine commercial review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceLockSha256", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sourceLockSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component",
          "revision",
          "reviewedFiles",
          "reviewer",
          "organization",
          "reviewDate",
          "decision",
          "conditions",
          "approvalReference"
        ],
        "properties": {
          "component": { "type": "string", "minLength": 1 },
          "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "reviewedFiles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "reviewer": { "type": "string", "minLength": 1 },
          "organization": { "type": "string", "minLength": 1 },
          "reviewDate": { "type": "string", "format": "date" },
          "decision": {
            "enum": ["approved", "approved-with-conditions", "not-reviewed", "rejected"]
          },
          "conditions": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "approvalReference": { "type": "string", "minLength": 1 },
          "reReviewDate": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
