{
  "name": "@hereisit/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/generate-web-headers.mjs && node ../../scripts/sync-pdfjs-assets.mjs && next dev",
    "build": "node ../../scripts/generate-web-headers.mjs && node ../../scripts/sync-pdfjs-assets.mjs && next build",
    "start": "wrangler pages dev out --ip 127.0.0.1 --port 3000 --compatibility-date=2026-07-10 --show-interactive-dev-session=false",
    "typecheck": "tsc --noEmit",
    "preview:test": "wrangler pages dev out --ip 127.0.0.1 --port 4173 --compatibility-date=2026-07-10 --log-level warn --show-interactive-dev-session=false"
  },
  "dependencies": {
    "@hereisit/browser-runtime": "workspace:*",
    "@hereisit/image-tool": "workspace:*",
    "@hereisit/pdf-tool": "workspace:*",
    "@hereisit/server-runtime": "workspace:*",
    "@hereisit/tool-contracts": "workspace:*",
    "@hereisit/tool-registry": "workspace:*",
    "fflate": "0.8.3",
    "next": "16.2.11",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "24.10.10",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "postcss": "8.5.16",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3"
  }
}
