{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hereisit.app/schemas/pdf-engine-release-gate.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "benchmarkSha256",
    "engineImageDigest",
    "corpusManifestSha256",
    "passed",
    "failures"
  ],
  "properties": {
    "schema": { "const": "hereisit.pdf-engine-release-gate@1" },
    "benchmarkSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "engineImageDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "corpusManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "passed": { "type": "boolean" },
    "failures": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 100,
      "items": { "type": "string", "pattern": "^[A-Z0-9:-]{3,100}$" }
    }
  }
}
