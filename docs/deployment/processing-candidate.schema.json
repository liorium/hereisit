{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hereisit.pages.dev/schemas/processing-candidate.schema.json",
  "title": "HereIsIt processing candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "state",
    "releaseId",
    "gitSha",
    "engine",
    "web",
    "security",
    "providerUsage",
    "releaseInputs",
    "costModel",
    "releaseAssets",
    "verificationSha256"
  ],
  "properties": {
    "schema": { "const": "hereisit-processing-candidate@1" },
    "version": { "const": 1 },
    "state": { "enum": ["built", "finalized"] },
    "releaseId": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.[1-9]\\d*$" },
    "gitSha": { "$ref": "#/$defs/gitSha" },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loadedImage", "oci", "docker"],
      "properties": {
        "loadedImage": { "type": "string", "pattern": "^hereisit-image-engine:[a-f0-9]{40}$" },
        "oci": { "$ref": "#/$defs/ociImageIdentity" },
        "docker": { "$ref": "#/$defs/dockerImageIdentity" }
      }
    },
    "web": { "$ref": "#/$defs/webIdentities" },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trivyDbDigest"],
      "properties": { "trivyDbDigest": { "$ref": "#/$defs/digest" } }
    },
    "providerUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaSha256"],
      "properties": { "schemaSha256": { "$ref": "#/$defs/sha256" } }
    },
    "releaseInputs": { "$ref": "#/$defs/hashedIdentity" },
    "costModel": { "$ref": "#/$defs/hashedIdentity" },
    "releaseAssets": {},
    "verificationSha256": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "finalized" } } },
      "then": { "properties": { "releaseAssets": { "$ref": "#/$defs/finalizedReleaseAssets" } } },
      "else": { "properties": { "releaseAssets": { "$ref": "#/$defs/builtReleaseAssets" } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "digestList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/digest" }
    },
    "hashedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": { "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "ociImageIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configDigest", "distributionLayerDigests", "diffIds"],
      "properties": {
        "configDigest": { "$ref": "#/$defs/digest" },
        "distributionLayerDigests": { "$ref": "#/$defs/digestList" },
        "diffIds": { "$ref": "#/$defs/digestList" }
      }
    },
    "dockerImageIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configDigest", "diffIds"],
      "properties": {
        "configDigest": { "$ref": "#/$defs/digest" },
        "diffIds": { "$ref": "#/$defs/digestList" }
      }
    },
    "webIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archiveSha256", "treeSha256", "processingApiOrigin"],
      "properties": {
        "archiveSha256": { "$ref": "#/$defs/sha256" },
        "treeSha256": { "$ref": "#/$defs/sha256" },
        "processingApiOrigin": { "type": "string", "format": "uri" }
      }
    },
    "webIdentities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["staging", "production"],
      "properties": {
        "staging": { "$ref": "#/$defs/webIdentity" },
        "production": { "$ref": "#/$defs/webIdentity" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sizeBytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
        },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "webReleaseAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sizeBytes", "archiveSha256", "treeSha256", "processingApiOrigin"],
      "properties": {
        "path": { "type": "string", "enum": ["web-staging.tar", "web-production.tar"] },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "archiveSha256": { "$ref": "#/$defs/sha256" },
        "treeSha256": { "$ref": "#/$defs/sha256" },
        "processingApiOrigin": { "type": "string", "format": "uri" }
      }
    },
    "engineReleaseAssets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oci", "docker"],
      "properties": {
        "oci": { "$ref": "#/$defs/artifact" },
        "docker": { "$ref": "#/$defs/artifact" }
      }
    },
    "webReleaseAssets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["staging", "production"],
      "properties": {
        "staging": { "$ref": "#/$defs/webReleaseAsset" },
        "production": { "$ref": "#/$defs/webReleaseAsset" }
      }
    },
    "securityGateArtifact": {
      "allOf": [
        { "$ref": "#/$defs/artifact" },
        { "properties": { "sizeBytes": { "maximum": 1048576 } } }
      ]
    },
    "securityEvidenceArtifact": {
      "allOf": [
        { "$ref": "#/$defs/artifact" },
        { "properties": { "sizeBytes": { "maximum": 8388608 } } }
      ]
    },
    "securityScopeArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "webStaging", "webProduction", "worker", "lockfile"],
      "properties": {
        "engine": { "$ref": "#/$defs/securityEvidenceArtifact" },
        "webStaging": { "$ref": "#/$defs/securityEvidenceArtifact" },
        "webProduction": { "$ref": "#/$defs/securityEvidenceArtifact" },
        "worker": { "$ref": "#/$defs/securityEvidenceArtifact" },
        "lockfile": { "$ref": "#/$defs/securityEvidenceArtifact" }
      }
    },
    "securityReleaseAssets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gates", "sboms", "vulnerabilityReports"],
      "properties": {
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["imageEngine", "applicationSupplyChain", "vulnerability"],
          "properties": {
            "imageEngine": {
              "allOf": [
                { "$ref": "#/$defs/securityGateArtifact" },
                {
                  "properties": {
                    "path": { "const": "security-image-engine-license-gate.json" }
                  }
                }
              ]
            },
            "applicationSupplyChain": {
              "allOf": [
                { "$ref": "#/$defs/securityGateArtifact" },
                {
                  "properties": {
                    "path": { "const": "security-application-supply-chain-gate.json" }
                  }
                }
              ]
            },
            "vulnerability": {
              "allOf": [
                { "$ref": "#/$defs/securityGateArtifact" },
                { "properties": { "path": { "const": "security-vulnerability-gate.json" } } }
              ]
            }
          }
        },
        "sboms": {
          "allOf": [
            { "$ref": "#/$defs/securityScopeArtifacts" },
            {
              "properties": {
                "engine": {
                  "properties": { "path": { "const": "security-sbom-engine.cdx.json" } }
                },
                "webStaging": {
                  "properties": { "path": { "const": "security-sbom-web-staging.cdx.json" } }
                },
                "webProduction": {
                  "properties": { "path": { "const": "security-sbom-web-production.cdx.json" } }
                },
                "worker": {
                  "properties": { "path": { "const": "security-sbom-worker.cdx.json" } }
                },
                "lockfile": {
                  "properties": { "path": { "const": "security-sbom-lockfile.cdx.json" } }
                }
              }
            }
          ]
        },
        "vulnerabilityReports": {
          "allOf": [
            { "$ref": "#/$defs/securityScopeArtifacts" },
            {
              "properties": {
                "engine": { "properties": { "path": { "const": "security-trivy-engine.json" } } },
                "webStaging": {
                  "properties": { "path": { "const": "security-trivy-web-staging.json" } }
                },
                "webProduction": {
                  "properties": { "path": { "const": "security-trivy-web-production.json" } }
                },
                "worker": { "properties": { "path": { "const": "security-trivy-worker.json" } } },
                "lockfile": {
                  "properties": { "path": { "const": "security-trivy-lockfile.json" } }
                }
              }
            }
          ]
        }
      }
    },
    "evidenceReleaseAssets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle", "signature"],
      "properties": {
        "bundle": { "$ref": "#/$defs/artifact" },
        "signature": { "$ref": "#/$defs/artifact" }
      }
    },
    "builtReleaseAssets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "worker", "web", "releaseInputs", "costModel", "security"],
      "properties": {
        "engine": { "$ref": "#/$defs/engineReleaseAssets" },
        "worker": { "$ref": "#/$defs/artifact" },
        "web": { "$ref": "#/$defs/webReleaseAssets" },
        "releaseInputs": { "$ref": "#/$defs/artifact" },
        "costModel": { "$ref": "#/$defs/artifact" },
        "security": { "$ref": "#/$defs/securityReleaseAssets" }
      }
    },
    "finalizedReleaseAssets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report",
        "engine",
        "worker",
        "web",
        "releaseInputs",
        "costModel",
        "security",
        "evidence"
      ],
      "properties": {
        "report": { "$ref": "#/$defs/artifact" },
        "engine": { "$ref": "#/$defs/engineReleaseAssets" },
        "worker": { "$ref": "#/$defs/artifact" },
        "web": { "$ref": "#/$defs/webReleaseAssets" },
        "releaseInputs": { "$ref": "#/$defs/artifact" },
        "costModel": { "$ref": "#/$defs/artifact" },
        "security": { "$ref": "#/$defs/securityReleaseAssets" },
        "evidence": { "$ref": "#/$defs/evidenceReleaseAssets" }
      }
    }
  }
}
