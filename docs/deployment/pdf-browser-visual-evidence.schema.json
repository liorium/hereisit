{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hereisit.app/schemas/pdf-browser-visual-evidence.schema.json",
  "title": "HereIsIt PDF browser visual evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "passed",
    "gitSha",
    "sourceSha256",
    "checkRunId",
    "execution",
    "inputManifestSha256",
    "engineImageDigest",
    "corpusManifestSha256",
    "stratum",
    "projects",
    "visualProfilesMeasured"
  ],
  "properties": {
    "schema": { "const": "hereisit.pdf-browser-visual-evidence@1" },
    "version": { "const": 1 },
    "passed": { "const": true },
    "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "checkRunId": { "type": "integer", "minimum": 1 },
    "execution": { "const": "exact-main-hosted-pdf-visual" },
    "inputManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "engineImageDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "corpusManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stratum": { "const": "jpeg-heavy" },
    "projects": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/project" }
    },
    "visualProfilesMeasured": { "const": 9 }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repeat", "sha256", "byteLength", "verified"],
      "properties": {
        "repeat": { "type": "integer", "minimum": 0, "maximum": 2 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 52428800 },
        "verified": { "const": true }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "passed", "results"],
      "properties": {
        "project": { "enum": ["chromium", "firefox", "webkit"] },
        "passed": { "const": true },
        "results": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/result" }
        }
      }
    }
  }
}
