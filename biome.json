{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "files": {
    "includes": [
      "**",
      "!!apps/api-worker/src/worker-configuration.d.ts",
      "!!apps/web/public/pdfjs",
      "!!**/.next",
      "!!**/.turbo",
      "!!**/target",
      "!!**/coverage",
      "!!**/dist",
      "!!**/playwright-report",
      "!!**/test-results",
      "!!**/out",
      "!!**/.wrangler",
      "!!**/.artifacts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noImportantStyles": "off"
      }
    }
  }
}
