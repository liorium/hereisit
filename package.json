{
  "name": "hereisit",
  "version": "0.1.0",
  "private": true,
  "description": "Fast, private, local-first file tools.",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "audit:prod": "pnpm audit --prod --audit-level moderate",
    "analytics:report": "node scripts/report-product-analytics.mjs",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:worker": "pnpm --filter @hereisit/api-worker test:integration",
    "test:processing-stack": "node scripts/test-processing-stack.mjs",
    "prepare:image-engine:local": "node scripts/prepare-image-engine-local.mjs",
    "test:image-engine:fuzz:pr": "pnpm prepare:image-engine:local && node scripts/fuzz-image-engine.mjs --duration-seconds 60 --seed 20260716 --engine-image hereisit-image-engine:local-source",
    "verify": "pnpm audit:prod && pnpm lint && pnpm typecheck && pnpm test && pnpm test:worker && pnpm test:image-engine:fuzz:pr && pnpm build && pnpm verify:export",
    "test:e2e:ci": "playwright test",
    "verify:all": "pnpm verify && pnpm test:processing-stack",
    "verify:export": "node scripts/verify-static-export.mjs && node scripts/verify-discovery-imports.mjs && node scripts/verify-discovery-bundles.mjs",
    "smoke:navigation": "node scripts/smoke-navigation.mjs",
    "cloudflare:preview": "pnpm --filter @hereisit/web start",
    "cloudflare:whoami": "wrangler whoami",
    "cloudflare:login": "wrangler login"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@cantoo/pdf-lib": "2.7.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.10",
    "@vitest/coverage-v8": "4.1.10",
    "fflate": "0.8.3",
    "turbo": "2.10.4",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "wrangler": "4.111.0"
  }
}
